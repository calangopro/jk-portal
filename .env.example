# === Supabase ===============================================================
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Chave de servidor (service_role). NUNCA use prefixo NEXT_PUBLIC_.
# Usada só no servidor (futura área /admin e scripts). Opcional neste scaffold.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === Site ===================================================================
# ORIGEM pública do portal: só esquema e host, SEM caminho e SEM barra no fim.
#
# O portal roda dentro de /guias (basePath, em next.config.ts). O prefixo NÃO
# entra aqui: ele mora em src/lib/seo/base-path.ts, e `absoluteUrl()` soma os
# dois. Escrever ".../guias" nesta variável faria todo canonical sair errado,
# porque `new URL("/guia/x", base)` descarta o caminho da base.
#
# Produção: https://www.jkaliancas.com.br
#   (o domínio continua na Tray; o Cloudflare manda só /guias/* para a Vercel,
#    então o endereço público do portal é https://www.jkaliancas.com.br/guias)
# Local:    http://localhost:3000  -> portal em http://localhost:3000/guias
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === OpenAI =================================================================
# Usada só no servidor, pelo analisador de SEO e GEO do admin.
# NUNCA use prefixo NEXT_PUBLIC_. Rotacione a chave ao fim do desenvolvimento.
OPENAI_API_KEY=sk-proj-your-key

# === Tray (catálogo, somente leitura) ======================================
# Sem estas, a sincronização fica desligada e o painel avisa.
# Nenhuma leva prefixo NEXT_PUBLIC_.
TRAY_API_URL=https://SUALOJA.commercesuite.com.br/web_api
TRAY_CONSUMER_KEY=
TRAY_CONSUMER_SECRET=
TRAY_CODE=
# Segredo do webhook. Sem ele a rota /api/tray/webhook fica desligada.
TRAY_WEBHOOK_SECRET=

# Segredo que assina a URL de preview de rascunho. Sem ele, o preview cai na
# service_role. Trocar aqui invalida todos os links de preview de uma vez.
PREVIEW_SECRET=

# IndexNow: avisa Bing, Yandex e Seznam quando uma página é publicada. Gere uma
# string hexadecimal de 32 caracteres. Sem chave, o aviso simplesmente não sai.
# A chave é servida em /indexnow.txt, que é como o buscador confirma o domínio.
INDEXNOW_KEY=
